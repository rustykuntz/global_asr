# Project runtime
ASR_VENV_PATH=.venv
STT_BACKEND=local

# Hotkeys (pynput Key names or single character)
# Examples: f4, f6, enter, esc, tab, a, /
ASR_ACTION_KEY=f4
ASR_MODE_KEY=f6
ASR_STOP_KEY=enter
ASR_CANCEL_KEY=esc

# OpenAI backend (required only when STT_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_PROMPT=

# Local backend: macOS uses MLX Whisper Turbo
# WHISPER_TURBO_WITHOUT_TIMESTAMPS=1

# Local backend: Windows uses faster-whisper
# FASTER_WHISPER_MODEL=large-v3-turbo
# FASTER_WHISPER_DEVICE=auto
# FASTER_WHISPER_COMPUTE_TYPE=int8

# Local backend: Linux uses whisper.cpp
# WHISPER_CPP_DIR=whisper.cpp
# WHISPER_CPP_MODEL=large-v3-turbo
# WHISPER_CPP_MODEL_PATH=whisper.cpp/models/ggml-large-v3-turbo.bin
# WHISPER_CPP_BINARY=whisper.cpp/build/bin/whisper-cli
# WHISPER_CPP_DEVICE=0
# WHISPER_CPP_THREADS=8
# WHISPER_CPP_BEAM_SIZE=1
# WHISPER_CPP_BEST_OF=1
# WHISPER_CPP_TEMPERATURE=0
# WHISPER_CPP_TEMPERATURE_INC=0
# WHISPER_CPP_MAX_CONTEXT=0
# WHISPER_CPP_NO_FALLBACK=1
# WHISPER_CPP_SUPPRESS_NST=1

# Optional path to text replacements file (default: transcription_replacements.txt)
# ASR_REPLACEMENTS_FILE=transcription_replacements.txt

# macOS only: lower system output volume during manual recording, then restore it.
# ASR_DUCK_OUTPUT_AUDIO=1
# ASR_DUCK_OUTPUT_VOLUME=0
# ASR_DUCK_FADE_MS=180

# Optional thresholds (defaults shown in code)
# ASR_SILENCE_WAIT=normal
# VAD_POSITIVE_THRESHOLD=0.3
# VAD_NEGATIVE_THRESHOLD=0.25
# VAD_MIN_SPEECH_DURATION_MS=400
# VAD_REDEMPTION_DURATION_MS=1000
# VAD_PRE_SPEECH_PADDING_MS=800
# VAD_USER_SPEAKING_THRESHOLD=0.6
# ASR_DICTATION_THRESHOLD=-0.12
# ASR_COMMAND_THRESHOLD=-0.2
# ASR_ENERGY_THRESHOLD=-45.6
